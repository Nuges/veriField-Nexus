{
  "version": 1,
  "author": "VeriField Nexus MRV Platform",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot1",
      "top": -90,
      "left": 150,
      "attrs": { "min": "0", "max": "4095", "value": "1370" }
    },
    {
      "type": "wokwi-ds18b20",
      "id": "temp1",
      "top": 120,
      "left": 150,
      "attrs": { "temperature": "29.4" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serial:rx", "", [] ],
    [ "esp:RX", "$serial:tx", "", [] ],
    [ "esp:GND.1", "pot1:GND", "black", [ "h-15", "v-60" ] ],
    [ "esp:3V3", "pot1:VCC", "red", [ "h-25", "v-80" ] ],
    [ "esp:D34", "pot1:SIG", "green", [ "h15", "v-60" ] ],
    [ "esp:GND.2", "temp1:GND", "black", [ "h-15", "v60" ] ],
    [ "esp:3V3", "temp1:VCC", "red", [ "h-25", "v80" ] ],
    [ "esp:D4", "temp1:DQ", "blue", [ "h20", "v40" ] ]
  ],
  "dependencies": {
    "OneWire": "2.3.8",
    "DallasTemperature": "3.11.0",
    "ArduinoJson": "6.21.3"
  }
}
