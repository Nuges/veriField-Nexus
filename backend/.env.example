# =============================================================================
# VeriField Nexus — Backend Environment Variables
# =============================================================================

# --- Supabase Configuration ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

# --- JWT ---
JWT_SECRET=your-supabase-jwt-secret
JWT_ALGORITHM=HS256

# --- App & Environment Governance ---
APP_NAME=VeriField Nexus
APP_VERSION=1.0.0
APP_ENV=development  # development, staging, production
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Bootstrap Super Admin Identity:
# Required in production (APP_ENV=production) for one-time initialization of the platform Super Admin.
# If omitted or empty in production, bootstrap provisioning is disabled.
VERIFIELD_BOOTSTRAP_ADMIN_EMAIL=

# --- Trust Engine Thresholds ---
TRUST_GPS_MAX_DISTANCE_KM=5.0
TRUST_IMAGE_HASH_THRESHOLD=5
TRUST_MAX_SUBMISSIONS_PER_HOUR=10

# --- Email Notifications (Deferred pending production domain configuration) ---
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=VeriField Nexus
